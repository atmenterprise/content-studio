# Server-only. Copy to .env.local; never use NEXT_PUBLIC_ for these values.
DATABASE_URL=postgresql://postgres:studio-local@localhost:55432/content_studio
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
# Generate with: openssl rand -hex 32
AUTH0_SECRET=
AUTH0_AUDIENCE=https://content-studio.example/api
APP_BASE_URL=http://localhost:3000
# A dedicated disposable PostgreSQL database for integration tests only.
TEST_DATABASE_URL=postgresql://postgres:studio-local@localhost:55432/content_studio_test
